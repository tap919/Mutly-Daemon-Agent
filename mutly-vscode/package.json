{
  "name": "mutly",
  "displayName": "Mutly Copilot Core Agent",
  "description": "Mutly back-end local transport integration for VS Code Companion Chat",
  "version": "0.2.0",
  "publisher": "mutly-ai",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Language",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "mutly",
        "name": "mutly",
        "description": "Speak with the local background Mutly daemon and run tests or apply diffs.",
        "isDefault": true
      }
    ],
    "commands": [
      {
        "command": "mutly.status",
        "title": "Mutly: Show Daemon Status"
      },
      {
        "command": "mutly.setApiKey",
        "title": "Mutly: Set API Key"
      },
      {
        "command": "mutly.runReview",
        "title": "Mutly: Run Review",
        "icon": "$(search)"
      },
      {
        "command": "mutly.showDashboard",
        "title": "Mutly: Show Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mutly-sidebar",
          "title": "Mutly",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "mutly-sidebar": [
        {
          "type": "webview",
          "id": "mutly.reviewPanel",
          "name": "RepoRank Review"
        }
      ]
    },
    "configuration": {
      "title": "Mutly",
      "properties": {
        "mutly.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Secure API key for accessing the local Mutly background daemon."
        },
        "mutly.daemonPort": {
          "type": "number",
          "default": 3000,
          "markdownDescription": "Port the Mutly daemon is listening on."
        },
        "mutly.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show RepoRank review score as a CodeLens above each open file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.19.0",
    "typescript": "^5.0.4"
  }
}
