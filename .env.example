# ── Server ──────────────────────────────────────────────────
PORT=3000
MUTLY_WS_PORT=24678
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MUTLY_API_KEY=
MUTLY_DATA_DIR=./data
MUTLY_SANDBOX_DIR=
MUTLY_ALLOW_SIMULATION_STUBS=false

# ── Stage 2 — MCP / VibeServe ───────────────────────────────
ENABLE_VIBESERVE_MCP=true
ENABLE_VIBESERVE_PLANNING=false
VIBESERVE_MUTLY_API_KEY=
VIBESERVE_MCP_URL=http://127.0.0.1:8000
VIBESERVE_API_KEY=
VIBESERVE_REQUIRE_AUTH=true
VIBESERVE_ENABLED_TOOLS=vs_memory_get,vs_memory_store,vs_schema_validate
VIBESERVE_TOOL_TIMEOUT_MS=10000
VIBESERVE_MAX_RESPONSE_CHARS=12000

# ── Stage 4 — Routing ───────────────────────────────────────
ENABLE_ADAPTIVE_ROUTING=true
ROUTING_DEFAULT_PATH=native
ROUTING_ENABLE_MODEL_FALLBACK=true
ROUTING_ENABLE_TOOL_FALLBACK=true
ROUTING_MAX_REMOTE_CALLS_PER_STEP=3
ROUTING_STEP_BUDGET_TOKENS=50000
ROUTING_STEP_BUDGET_USD=0.25

# ── RepoRank integration ──────────────────────────────────
REPORANK_ENABLED=true
REPORANK_API_URL=http://localhost:3001
# Generate a strong random key (openssl rand -hex 32) and set the same value on RepoRank's side
REPORANK_API_KEY=
REPORANK_BLOCK_ON_SECRETS=true

# ── Stage 5 — Governance ────────────────────────────────────
ENABLE_AUTONOMOUS_PIPELINES=false
ENABLE_HUMAN_APPROVALS=true
AUTONOMY_KILL_SWITCH=false
REQUIRE_APPROVAL_FOR_OVERWRITE_CRITICAL_FILES=true
REQUIRE_APPROVAL_FOR_REMOTE_GENERATED_ARTIFACTS=true
REQUIRE_APPROVAL_FOR_DEPENDENCY_CHANGES=true
MAX_FILES_CHANGED_PER_STEP=10
MAX_FILES_CHANGED_PER_WORKFLOW=25
MAX_REMOTE_ARTIFACT_SIZE_CHARS=50000
MAX_COST_PER_WORKFLOW_USD=2.00
MAX_APPROVAL_WAIT_HOURS=24
REPORANK_BLOCK_ON_SECRETS=true

# ── Observability ───────────────────────────────────────────
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mutly-daemon

# ── Inngest ─────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Agent ───────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Redis Cache (optional) ──────────────────────────────────
# Leave REDIS_URL blank to use the in-process memory cache (no Redis needed).
# Set to a redis:// URL to enable persistent, cross-restart caching.
REDIS_URL=
# How long (seconds) audit results are cached. Default: 300 (5 min)
REDIS_CACHE_TTL_AUDIT_SECONDS=300
# How long (seconds) lightweight state snapshots are cached. Default: 30
REDIS_CACHE_TTL_STATE_SECONDS=30

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
